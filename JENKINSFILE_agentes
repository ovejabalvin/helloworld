pipeline {
    agent none 

    stages {
        stage('Get Code') {
            agent { label 'built-in' } 
            steps {
                git 'https://github.com/ovejabalvin/helloworld.git'
                bat 'whoami & hostname & echo %WORKSPACE%'
            }
        }

        stage('Parallel Quality Checks') {
            parallel {
                stage('Unit & Coverage') {
                    agent { label 'built-in' }
                    steps {
                        bat 'whoami & hostname & echo %WORKSPACE%'
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            bat '''
                                set PYTHONPATH=%WORKSPACE%
                                pytest --junitxml=result-unit.xml --cov=app --cov-report=xml:coverage.xml test\\unit
                            '''
                        }
                        junit 'result-unit.xml'
                        recordCoverage(tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']])
                    }
                }

                stage('Static Analysis') {
                    agent { label 'built-in' }
                    steps {
                        bat 'whoami & hostname & echo %WORKSPACE%'
                        bat 'flake8 app test > flake8.out || exit 0'
                        recordIssues tools: [flake8(pattern: 'flake8.out')]
                    }
                }

stage('Security') {
                    agent { label 'built-in' }
                    steps {
                        bat 'whoami & hostname & echo %WORKSPACE%'
                        
                        bat 'bandit -r app -f custom -o bandit.out --msg-template "{abspath}:{line}: {severity}: {test_id}: {msg}" || exit 0'
                        
                        recordIssues tools: [pep8(pattern: 'bandit.out', id: 'bandit', name: 'Bandit')]
                    }
                }
            }
        }

         stage('Integration & Performance') {
            agent { label 'built-in' }
            steps {
                bat 'whoami & hostname & echo %WORKSPACE%'
                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                    bat '''
                        set BUILD_ID=dontKillMe
                        set JENKINS_NODE_COOKIE=dontKillMe
                        set FLASK_APP=app\\api.py
                        set FLASK_ENV=development
                        
                        echo "Iniciando Flask..."
                        start "" /B python -m flask run > flask.log 2>&1 <NUL
                        
                        echo "Iniciando Wiremock..."
                        start "" /B java -jar C:\\Users\\Andres\\Downloads\\wiremock-standalone-3.13.2.jar --port 9090 --root-dir test\\wiremock > wiremock.log 2>&1 <NUL
                        
                        echo "Esperando a los servidores..."
                        ping 127.0.0.1 -n 6 > NUL
                        
                        echo "Ejecutando Pytest..."
                        set PYTHONPATH=%WORKSPACE%
                        pytest --junitxml=result-rest.xml test\\rest
                        
                        echo "Ejecutando JMeter..."
                        C:"C:\\Users\\Andres\\Desktop\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3\\bin\\jmeter.bat" -n -t test\\jmeter\\flask.jmx -l result.jtl
                    '''
                }
                junit 'result-rest.xml'
                perfReport 'result.jtl'
            }

            post {
        always {
            bat '''
                echo "Limpiando procesos en segundo plano..."
                for /f "tokens=5" %%a in ('netstat -aon ^| find ":5000" ^| find "LISTENING"') do taskkill /f /pid %%a || exit 0
                for /f "tokens=5" %%a in ('netstat -aon ^| find ":9090" ^| find "LISTENING"') do taskkill /f /pid %%a || exit 0
            '''
        }
    }
        }
        }
    }
