pipeline {
    agent any

    stages {
        stage('Get Code') {
            steps {
                git 'https://github.com/ovejabalvin/helloworld.git'
            }
        }

        stage('Unit') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat '''
                        set PYTHONPATH=%WORKSPACE%
                        pip install pytest-cov
                        pytest --junitxml=result-unit.xml --cov=app --cov-report=xml:coverage.xml test\\unit
                    '''
                }
                junit 'result-unit.xml'
            }
        }

        stage('Coverage') {
            steps {
                recordCoverage(tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']],
                               qualityGates: [
                                   [threshold: 85.0, metric: 'LINE', baseline: 'PROJECT', unstable: true],
                                   [threshold: 95.0, metric: 'LINE', baseline: 'PROJECT', unstable: false],
                                   [threshold: 80.0, metric: 'BRANCH', baseline: 'PROJECT', unstable: true],
                                   [threshold: 90.0, metric: 'BRANCH', baseline: 'PROJECT', unstable: false]
                               ])
            }
        }

        stage('Static') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                    bat 'flake8 app test > flake8.out || exit 0'
                }
                recordIssues tools: [flake8(pattern: 'flake8.out')],
                             qualityGates: [
                                 [threshold: 8, type: 'TOTAL', unstable: true],
                                 [threshold: 10, type: 'TOTAL', unstable: false]
                             ]
            }
        }

      stage('Security Test') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                    
                    bat 'bandit -r app -f custom -o bandit.out --msg-template "{abspath}:{line}: {severity}: {test_id}: {msg}" || exit 0'
                }
                
                recordIssues tools: [pep8(pattern: 'bandit.out', id: 'bandit', name: 'Bandit')],
                             qualityGates: [
                                 [threshold: 2, type: 'TOTAL', unstable: true],
                                 [threshold: 4, type: 'TOTAL', unstable: false]
                             ]
            }
        }

        stage('Rest') {
            steps {
                bat '''
                    set FLASK_APP=app\\api.py
                    set FLASK_ENV=development
                    start /b flask run
                    start /b java -jar C:\\Unir\\Ejercicios\\wiremock\\wiremock-jre8-standalone-2.28.0.jar --port 9090 --root-dir test\\wiremock
                    timeout /t 5
                    set PYTHONPATH=%WORKSPACE%
                    pytest --junitxml=result-rest.xml test\\rest
                '''
                junit 'result-rest.xml'
            }    
        }
        
        stage('Performance') {
            steps {
                bat 'jmeter -n -t test\\jmeter\\flask.jmx -l result.jtl'
                perfReport 'result.jtl'
            }
        }
    }
}